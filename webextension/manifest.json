{
  "manifest_version": 3,
  "name": "Teams IC3",
  "version": "0.2.0",
  "description": "Connects the Teams session to the local teams-ic3 host.",
  "permissions": ["webRequest", "nativeMessaging"],
  "host_permissions": [
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Teams IC3"
  }
}
